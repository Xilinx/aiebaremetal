all:
{
    image
    {
        { type=bootimage, file=./arch/platform/pdi/vek280/allgmio.pdi }
    }
    image
    {
        name=aie_image, id=0x1c000000
        { type=cdo
          /* The following commented lines show the CDOs used to create a merged CDO 'aie.cdo.merged.bin'. For debugging purpose,
             uncomment these CDOs and comment the line that adds 'aie.cdo.merged.bin' */
          file = ./aie/Work/ps/cdo/aie_cdo_reset.bin
          file = ./aie/Work/ps/cdo/aie_cdo_clock_gating.bin
          file = ./aie/Work/ps/cdo/aie_cdo_error_handling.bin
          file = ./aie/Work/ps/cdo/aie_cdo_elfs.bin
          file = ./aie/Work/ps/cdo/aie_cdo_init.bin
          /*file=aie.merged.cdo.bin*/
        }
    }
}
