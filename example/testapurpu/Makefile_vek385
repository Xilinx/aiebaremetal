acc = aarch64-none-elf-gcc
rcc = armr5-none-eabi-gcc
PWD := $(shell pwd)
ARCH_DIR=$(PWD)/../../thirdparty/arch/ps/
ARCH_78_DIR=$(ARCH_DIR)/cortexa78_0/standalone_cortexa78_0/bsp
ARCH_R52_DIR=$(ARCH_DIR)/cortexr52_0/standalone_cortexr52_0/bsp
APUFLAG = -mcpu=cortex-a78 -D__AIE_ARCH__=22 -Wl,-T -Wl,$(ARCH_78_DIR)/lscript.ld -I$(ARCH_78_DIR)/include/
RPUFLAG = -mcpu=cortex-r52 -D__AIE_ARCH__=22 -mfpu=vfpv3-d16  -DARMR5 -Wall -Wextra -mfloat-abi=hard 
RPUFLAG += -fno-tree-loop-distribute-patterns -Dversal -fno-tree-loop-distribute-patterns
RPUFLAG += -T $(ARCH_R52_DIR)/lscript.ld -I$(ARCH_R52_DIR)/include/

APU_LD_FLAG = -L$(ARCH_78_DIR)/lib -Wl,--start-group,-lxil,-lxiltimer,-lxilstandalone,-lgcc,-lc,-lstdc++,--end-group
RPU_LD_FLAG = -L$(ARCH_R52_DIR)/lib -Wl,--start-group,-lxil,-lxiltimer,-lxilstandalone,-lgcc,-lc,-lstdc++,--end-group

all : apu rpu

apu: apu.c common.c
	$(acc) -o $@ $^ $(APUFLAG) $(APU_LD_FLAG)

rpu: rpu.c common.c
	$(rcc) -o $@ $^ $(RPUFLAG) $(RPU_LD_FLAG)

clean:
	rm apu
	rm rpu
