all:
{
    image
    {
        { type=bootimage, file=../pl_kernels/_x/link/vivado/vpl/prj/prj.runs/impl_1/vitis_design_wrapper_boot.pdi }

    }
    image
    {
        { type=bootimage, file=../pl_kernels/_x/link/vivado/vpl/prj/prj.runs/impl_1/vitis_design_wrapper_pld.pdi }
    }
    image
    {
        name=aie_image, id=0x18800000
        { type=cdo
          file = ../Work/ps/cdo/aie_cdo_reset.bin
          file = ../Work/ps/cdo/aie_cdo_clock_gating.bin
          file = ../Work/ps/cdo/aie_cdo_error_handling.bin
          file = ../Work/ps/cdo/aie_cdo_elfs.bin
          file = ../Work/ps/cdo/aie_cdo_init.bin
        }
    }
    image
    {
        name=default_subsys, id=0x1c000000
        { core=a78-0, file=./vek385.elf }
    }

}
