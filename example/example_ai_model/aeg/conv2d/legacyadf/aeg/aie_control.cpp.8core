  bool EG_load_elf(const std::string& work_path, std::vector<std::string>& elfInfoPath)
  {
	#ifdef __PS_INIT_AIE__

	std::string work_dir = (work_path.empty() ?  "/scratch/staff/huaj/aiebr/conv2dn/aiebaremetal2/test/test_external_buffer2/Work" : work_path);
	std::cout<<"Loading elfs of graph EG..."<<std::endl;
	if(XAie_LoadElf(&DevInst, XAie_TileLoc(0, 3), (work_dir + "/aie/0_0/Release/0_0").c_str(), XAIE_ENABLE)!=XAIE_OK)
	{
		std::cerr << "ERROR: Failed to load elf for core(0,0)" << std::endl;
		return false;
	}
	if(XAie_LoadElf(&DevInst, XAie_TileLoc(0, 4), (work_dir + "/aie/0_1/Release/0_1").c_str(), XAIE_ENABLE)!=XAIE_OK)
	{
		std::cerr << "ERROR: Failed to load elf for core(0,1)" << std::endl;
		return false;
	}
	if(XAie_LoadElf(&DevInst, XAie_TileLoc(0, 5), (work_dir + "/aie/0_2/Release/0_2").c_str(), XAIE_ENABLE)!=XAIE_OK)
	{
		std::cerr << "ERROR: Failed to load elf for core(0,2)" << std::endl;
		return false;
	}
	if(XAie_LoadElf(&DevInst, XAie_TileLoc(0, 6), (work_dir + "/aie/0_3/Release/0_3").c_str(), XAIE_ENABLE)!=XAIE_OK)
	{
		std::cerr << "ERROR: Failed to load elf for core(0,3)" << std::endl;
		return false;
	}
	if(XAie_LoadElf(&DevInst, XAie_TileLoc(0, 7), (work_dir + "/aie/0_4/Release/0_4").c_str(), XAIE_ENABLE)!=XAIE_OK)
	{
		std::cerr << "ERROR: Failed to load elf for core(0,4)" << std::endl;
		return false;
	}
	if(XAie_LoadElf(&DevInst, XAie_TileLoc(0, 8), (work_dir + "/aie/0_5/Release/0_5").c_str(), XAIE_ENABLE)!=XAIE_OK)
	{
		std::cerr << "ERROR: Failed to load elf for core(0,5)" << std::endl;
		return false;
	}
	if(XAie_LoadElf(&DevInst, XAie_TileLoc(0, 9), (work_dir + "/aie/0_6/Release/0_6").c_str(), XAIE_ENABLE)!=XAIE_OK)
	{
		std::cerr << "ERROR: Failed to load elf for core(0,6)" << std::endl;
		return false;
	}
	if(XAie_LoadElf(&DevInst, XAie_TileLoc(0, 10), (work_dir + "/aie/0_7/Release/0_7").c_str(), XAIE_ENABLE)!=XAIE_OK)
	{
		std::cerr << "ERROR: Failed to load elf for core(0,7)" << std::endl;
		return false;
	}
	#endif

	return true;
  }

  adf::return_code EG_init(const std::string& work_path)
  {

	std::cout<<"Initializing graph EG..."<<std::endl;

	int driverStatus = AieRC::XAIE_OK;

    #ifdef __PS_INIT_AIE__

	std::string work_dir = (work_path.empty() ?  "/scratch/staff/huaj/aiebr/conv2dn/aiebaremetal2/test/test_external_buffer2/Work" : work_path);
	// S_EAST_ch2_C0_R0 M_NORTH_ch4_C0_R0 net10

	driverStatus |= XAie_StrmConnCctEnable(&DevInst, XAie_TileLoc(0, 3), EAST, 2, NORTH, 4);

	// S_EAST_ch2_C0_R0 M_S2MM_DMA_ch1_C0_R0 net10

	driverStatus |= XAie_StrmConnCctEnable(&DevInst, XAie_TileLoc(0, 3), EAST, 2, DMA, 1);

	// S_EAST_ch2_C1_R0 M_WEST_ch2_C1_R0 net10

	driverStatus |= XAie_StrmConnCctEnable(&DevInst, XAie_TileLoc(1, 3), EAST, 2, WEST, 2);

	// S_EAST_ch3_C0_R0 M_NORTH_ch5_C0_R0 net2

	driverStatus |= XAie_StrmConnCctEnable(&DevInst, XAie_TileLoc(0, 3), EAST, 3, NORTH, 5);

	// S_EAST_ch3_C0_R0 M_S2MM_DMA_ch0_C0_R0 net2

	driverStatus |= XAie_StrmConnCctEnable(&DevInst, XAie_TileLoc(0, 3), EAST, 3, DMA, 0);

	// S_EAST_ch3_C1_R0 M_WEST_ch3_C1_R0 net2

	driverStatus |= XAie_StrmConnCctEnable(&DevInst, XAie_TileLoc(1, 3), EAST, 3, WEST, 3);

	// S_MEMTILE_MM2S_DMA_ch0_C2_R0 M_MEMTILE_NORTH_ch5_C2_R0 net2

	driverStatus |= XAie_StrmConnCctEnable(&DevInst, XAie_TileLoc(2, 1), DMA, 0, NORTH, 5);

	// S_MEMTILE_MM2S_DMA_ch1_C2_R0 M_MEMTILE_NORTH_ch4_C2_R0 net10

	driverStatus |= XAie_StrmConnCctEnable(&DevInst, XAie_TileLoc(2, 1), DMA, 1, NORTH, 4);

	// S_MEMTILE_NORTH_ch3_C0_R0 M_MEMTILE_SOUTH_ch3_C0_R0 net25

	driverStatus |= XAie_StrmConnCctEnable(&DevInst, XAie_TileLoc(0, 1), NORTH, 3, SOUTH, 3);

	// S_MEMTILE_NORTH_ch3_C0_R1 M_MEMTILE_SOUTH_ch3_C0_R1 net25

	driverStatus |= XAie_StrmConnCctEnable(&DevInst, XAie_TileLoc(0, 2), NORTH, 3, SOUTH, 3);

	// S_MEMTILE_SOUTH_ch4_C2_R0 M_MEMTILE_S2MM_DMA_ch0_C2_R0 net0

