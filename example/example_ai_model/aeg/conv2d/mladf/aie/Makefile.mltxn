ifeq ($(XILINX_VITIS_AIETOOLS),)
XILINX_VITIS_AIETOOLS:=${XILINX_VITIS}/aietools
endif
.PHONY: all clean
.NOTPARALLEL:
all: clean run


compile:
	(${XILINX_VITIS_AIETOOLS}/tps/lnx64/gcc/bin/g++ -fPIC -fpermissive -g -std=c++17 -Wno-deprecated-declarations -Werror=return-type -D__AIE_ARCH__=20 -D__LOCK_FENCE_MODE__=0 -DAIE_OPTION_SCALAR_FLOAT_ON_VECTOR -DAIE2_FP32_EMULATION_ACCURACY_FAST -DSC_INCLUDE_DYNAMIC_PROCESSES -D__TXN_BIN__ -D__PS_INIT_AIE__ -DXAIE_DEBUG -I Work/ps/c_rts -I ${XILINX_VITIS_AIETOOLS}/include -I ${XILINX_VITIS_AIETOOLS}/include/drivers/aiengine -o Work/ps/ml_txn/generated-objects/genTxnMain.out Work/ps/ml_txn/generated-source/gen_txn.cpp  Work/ps/ml_txn/generated-source/gen_txn_main.cpp  -Wl,--allow-shlib-undefined  -lxaiengine -ladf_api -ladf_rt_ctrl_api -L ${XILINX_VITIS_AIETOOLS}/lib/lnx64.o )

write_txn_bin: compile
	(Work/ps/ml_txn/generated-objects/genTxnMain.out --write-txn "Work/ps/ml_txn/ml_txn.bin")

read_txn_bin:
	(Work/ps/ml_txn/generated-objects/genTxnMain.out --read-txn "Work/ps/ml_txn/ml_txn.bin")

clean:
	(rm -rf generated-objects/*)
