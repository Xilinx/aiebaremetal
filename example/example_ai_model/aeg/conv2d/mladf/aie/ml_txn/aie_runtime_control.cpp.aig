#ifdef __TXN_BIN__
typedef struct{
  int temp;
  unsigned int size_in_bytes;
} op_base;
typedef struct{
  uint32_t id;
} record_timer_id_op_t;
struct PatchShimOp {
  op_base op;
  uint32_t action;
  uint64_t regAddr;
  uint64_t extBufId;
  uint64_t argplus;
};
uint64_t ComputePatchRegAddr(uint8_t shimColumn, uint8_t bdId) {
  // get tile info
  XAie_LocType tileLoc = XAie_TileLoc(shimColumn, 0); //XAie_TileLoc(Col, Row)
  XAie_DmaDesc dmaInst;
  int driverStatus = XAie_DmaDescInit(&DevInst, &dmaInst, tileLoc);
  if (driverStatus != AieRC::XAIE_OK)
    std::cout << "########## ComputePatchRegAddr: AIE Driver Error" << std::endl;

  u64 regAddr = dmaInst.DmaMod->BaseAddr 
    + bdId * dmaInst.DmaMod->IdxOffset 
    + _XAie_GetTileAddr(&DevInst, tileLoc.Row, tileLoc.Col) 
    + dmaInst.DmaMod->BdProp->Buffer->ShimDmaBuff.AddrLow.Idx * 4U;


  return regAddr;
}

void DumpCustomOp(PatchShimOp op, std::string bufName)
{
  std::cout << "Custom op for: " << bufName << std::endl;
  std::cout << "action: " << op.action << ", regAddr: " << std::hex << op.regAddr << " , extBufId " << op.extBufId << " , argplus: " << std::hex << op.argplus << std::endl;
}
void AddDDRCustomOp(uint32_t action, uint64_t bufId, uint64_t offsetInBytes, uint8_t shimCol, uint8_t bdId, std::string bufName, int32_t patch_op_code)
{
    PatchShimOp op;
    op.action = action;
    op.regAddr = ComputePatchRegAddr(shimCol, bdId);
    op.extBufId = bufId;
    op.argplus = offsetInBytes;

#ifdef __AIE_RUNTIME_CONTROL_LOG__
    DumpCustomOp(op, bufName);
#endif
    XAie_AddCustomTxnOp(&DevInst, patch_op_code, (void*)&op, sizeof(op));
}

void AddRecordTimerCustomOp(uint32_t id, int32_t op_code)
{
    record_timer_id_op_t op;
    op.id = id;
    XAie_AddCustomTxnOp(&DevInst, op_code, (void*)&op, sizeof(op));
}


    typedef struct {
        uint32_t word;
        uint32_t config;
    } tct_op_t;

    void AddWaitTctCustomOp(adf::tile_type tileType, uint32_t column, uint32_t row, adf::dma_channel_dir dir, uint32_t channel, uint32_t numTokens, int32_t tct_op_code)
    {
        while (numTokens > 0) {
            uint32_t word = 0;
            word |= (column << 16);
            word |= (dir == adf::dma_channel_dir::dma_mm2s) ? 1 : 0;
            if (tileType == adf::memory_tile)
                word |= (1 << 8);
                
            uint32_t config = 0;
            config |= (channel << 24);
            config |= (1 << 16);
            config |= (1 << 8);
            numTokens--;

            tct_op_t tct_op;
            tct_op.word = word;
            tct_op.config = config;

            __LOG__("Adding TctOp column " << column << " row " << row << " tile type: " << ((tileType == adf::memory_tile)?"mem tile" : "shim tile"));
            XAie_AddCustomTxnOp(&DevInst, tct_op_code, (void*)&tct_op, sizeof(tct_op));
        }
    }
    
#else
void ProcessLayerEvent(uint32_t id)
{
    return adf::recordTimer(id);
}
#endif

void executeRuntimeControl()
{


#ifdef __AIESIM__ 
    adf::syncPSToGM();
#endif
#if defined(__TXN_BIN__) && defined(__AIESIM__)
    uint8_t *Ptr =  ReadSerializedTransactionFromBin("Work/ps/ml_txn/ml_txn.bin");
    XAie_SubmitSerializedTransaction(Ptr);
#else
    executeRuntimeControlInternal();
#endif
#ifdef __AIESIM__ 
    adf::syncPSFromGM();
#endif


}

