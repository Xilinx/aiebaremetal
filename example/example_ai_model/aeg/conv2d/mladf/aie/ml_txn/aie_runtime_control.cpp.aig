#ifdef __TXN_BIN__
                AddDDRCustomOp(0,1, bd.address*4, 2,0,"compute_graph.ifm_ddr", patch_op_code);
#endif
            }
            __LOG__("Enqueue task for compute_graph.ifm_ddr.out[0]")
            adf::enqueueTask(adf::shim_tile,2,0, adf::dma_mm2s, 0, 0, 1, false);
