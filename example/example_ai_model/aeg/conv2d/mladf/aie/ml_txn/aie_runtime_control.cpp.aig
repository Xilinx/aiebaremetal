#ifdef __PL_CTRL_EXT_BUF_NAME__
                    .address = adf::getExternalBufferAddress("compute_graph.ifm_ddr", 0)/4,
#elif defined(__TXN_BIN__)
                    .address = 0,
#else // not compiling control code, e.g., simulation
                    .address = 0 + adf::getExternalBufferAddress(1)/4,
#endif
                    .length = 82944,
                    .stepsize = {1},
                    .wrap = {},
                    .padding = {},
                    .enable_packet = false,
                    .packet_id = 0,
                    .out_of_order_bd_id = 0,
                    .tlast_suppress = false,
                    .iteration_stepsize = 0,
                    .iteration_wrap = 0,
