        __LOG__("Initialize lock for compute_graph.ifm_ddr")
        adf::initializeLock(adf::shim_tile,2,0, 0, 0);
        __LOG__("Initialize lock for compute_graph.ifm_ddr")
        adf::initializeLock(adf::shim_tile,2,0, 1, 0);
        __LOG__("Initialize lock for compute_graph.ifm")
        adf::initializeLock(adf::memory_tile,0,0, 0, 0);
        __LOG__("Initialize lock for compute_graph.ifm")
        adf::initializeLock(adf::memory_tile,0,0, 1, 0);
        {
            __LOG__("Configure BD for compute_graph.ifm_ddr.out[0]")
            {
                adf::dma_buffer_descriptor bd = 
