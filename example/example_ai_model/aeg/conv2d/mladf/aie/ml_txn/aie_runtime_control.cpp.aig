#include "adf/adf_api/AIERuntimeControl.h"

#ifdef __AIE_RUNTIME_CONTROL_LOG__
#define __LOG__(msg) std::cout << msg << std::endl;
#else
#define __LOG__(msg)
#endif

#if defined(__TXN_BIN__)
extern "C"
{
 #include <xaiengine.h>
}
extern XAie_DevInst DevInst;
#endif

#ifdef __TXN_BIN__
void AddDDRCustomOp(uint32_t action, uint64_t bufId, uint64_t offsetInBytes, uint8_t shimCol, uint8_t bdId, std::string bufName, int32_t patch_op_code);
void AddRecordTimerCustomOp(uint32_t id, int32_t op_code);
uint8_t* ReadSerializedTransactionFromBin(std::string TxnBinFileName);
void XAie_SubmitSerializedTransaction(uint8_t *Ptr);
void AddWaitTctCustomOp(adf::tile_type tileType, uint32_t column, uint32_t row, adf::dma_channel_dir dir, uint32_t channel, uint32_t numTokens, int32_t tct_op_code);
#else
void ProcessLayerEvent(uint32_t id);
#endif
void executeRuntimeControlInternal()
{
    //multi-layer schedule for overlay
#ifdef __TXN_BIN__
    int32_t patch_op_code = XAIE_IO_CUSTOM_OP_DDR_PATCH;
    int32_t temp = XAie_RequestCustomTxnOp(&DevInst);
    int32_t record_timer_op_code = XAie_RequestCustomTxnOp(&DevInst);
